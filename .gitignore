runs/*/data/
runs/*/live/frames/

# Rendered manuscripts (tools/md_to_pdf.py)
docs/*.pdf

# Packaged submission sources
paper/*.zip

# Packaged data archive
data_C1.zip

# Compiled or packaged paper outputs
paper/**/*.pdf
paper/*.pdf
paper/**/*.zip
!data_C1/**

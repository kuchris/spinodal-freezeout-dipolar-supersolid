# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Simulation output (never committed)
results/
*.npz
*.npy
*.h5
*.hdf5

# Run records (dipgpe.runs): metadata, results, logs and figures are committed;

+def pooled(ids):
+    """{tau: [D, ...]} over several runs (extra realizations of the same tau_Q)."""
+    out = {}
+    for rid in ids:
+        for tau, D in load(rid).items():
+            out.setdefault(tau, []).append(D)
+    return out
